# Copy this file to .env and fill in values locally. Never commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional ProfileKit defaults. The classroom app can change these per session.
PROFILEKIT_PROVIDER=deepseek
PROFILEKIT_MODEL=deepseek-flash
OPENAI_MODEL=gpt-6-luna
DEEPSEEK_MODEL=deepseek-flash
GEMINI_MODEL=gemini-3.5-flash
